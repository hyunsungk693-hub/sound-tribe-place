# 자체 Supabase 프로젝트 연결 정보
# Supabase 대시보드 → Project Settings → API 에서 확인
# 실제 값은 .env 파일에 넣고, .env는 절대 커밋하지 않기

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_PUBLIC_KEY

# PostHog (방문·체류·재방문 측정, 무료 티어 월 100만 이벤트)
# https://posthog.com 가입 후 Project API Key 확인
VITE_POSTHOG_KEY=phc_YOUR_KEY
VITE_POSTHOG_HOST=https://us.i.posthog.com

# 웹푸시 VAPID 공개키 (npx web-push generate-vapid-keys 로 생성한 Public Key)
# 비밀키는 Supabase secrets에만 저장: npx supabase secrets set VAPID_PRIVATE_KEY=...
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
